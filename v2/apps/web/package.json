{
  "name": "@signedprice/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/apply-content-database.mjs --if-configured && node scripts/seed-property-core.mjs --if-configured",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/apply-content-database.mjs",
    "db:seed:properties": "node scripts/seed-property-core.mjs",
    "db:verify:properties": "node scripts/seed-property-core.mjs --verify-only"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@signedprice/korea-rent": "workspace:*",
    "@signedprice/market-core": "workspace:*",
    "@signedprice/singapore-property": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.5",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.19.0"
}
