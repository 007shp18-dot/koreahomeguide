# Server-only persistent content database. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Vercel sends this value as Authorization: Bearer <CRON_SECRET> to cron routes.
CRON_SECRET=

# Used only by protected photo approval tools.
CONTENT_ADMIN_SECRET=

# Existing upstream integrations.
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
SIGNEDPRICE_PUBLIC_DATA_SERVICE_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_BROWSER_ENABLED=false

# Finite paid-provider guardrails for scheduled photo discovery.
PHOTO_GOOGLE_DAILY_REQUEST_CAP=100
PHOTO_GOOGLE_DAILY_SPEND_CAP_USD=0
PHOTO_NAVER_DAILY_REQUEST_CAP=25000

