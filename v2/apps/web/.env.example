# Server-only persistent content database. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Vercel sends this value as Authorization: Bearer <CRON_SECRET> to cron routes.
CRON_SECRET=

# Used by protected operator tools, including manual DLD CSV refreshes.
CONTENT_ADMIN_SECRET=

# Existing upstream integrations.
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
# NAVER Cloud Platform API HUB credentials (preferred for Image Search).
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# Legacy NAVER Developers credentials, kept only for pre-migration applications.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Comma-separated exact job allow-list. Empty keeps every scheduled market
# write disabled; enable one canary at a time after checking database capacity.
SIGNEDPRICE_MARKET_REFRESH_JOBS=
SIGNEDPRICE_PUBLIC_DATA_SERVICE_KEY=
# Free URA Data Service access key. Server-only.
SIGNEDPRICE_URA_ACCESS_KEY=
# Optional direct official HTTPS CSV endpoints. If absent, the matching DLD cron
# records a skipped run and operators can POST a small official CSV delta manually.
SIGNEDPRICE_DLD_TRANSACTIONS_CSV_URL=
SIGNEDPRICE_DLD_RENTS_CSV_URL=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Finite paid-provider guardrails for scheduled photo discovery.
PHOTO_GOOGLE_DAILY_REQUEST_CAP=5
PHOTO_GOOGLE_DAILY_SPEND_CAP_USD=0.16
PHOTO_NAVER_DAILY_REQUEST_CAP=25000
