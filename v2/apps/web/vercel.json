{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../..",
  "crons": [
    {
      "path": "/api/internal/news-ingest/",
      "schedule": "17 0 * * *"
    },
    {
      "path": "/api/internal/building-enrichment/?source=wikimedia&limit=60",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/internal/building-enrichment/?source=official&limit=250",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/internal/building-enrichment/?source=naver&limit=250",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/building-enrichment/?source=google&limit=30",
      "schedule": "47 * * * *"
    },
    {
      "path": "/api/internal/public-entity-projection/",
      "schedule": "57 0 * * *"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=kr-seoul-sale",
      "schedule": "10 18 * * *"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=kr-seoul-rent",
      "schedule": "25 18 * * *"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=sg-private-sale",
      "schedule": "10 2 * * 2,5"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=sg-private-rent",
      "schedule": "25 2 16 * *"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=ae-dubai-transaction",
      "schedule": "10 1 * * *"
    },
    {
      "path": "/api/internal/market-data-refresh/?job=ae-dubai-rent",
      "schedule": "25 1 * * *"
    },
    {
      "path": "/api/internal/japan-refresh/",
      "schedule": "40 * * * *"
    }
  ]
}
