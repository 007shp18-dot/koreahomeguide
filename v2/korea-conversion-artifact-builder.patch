diff --git a/v2/scripts/build-korea-conversion-artifact.mts b/v2/scripts/build-korea-conversion-artifact.mts
new file mode 100644
index 0000000..c195ac7
--- /dev/null
+++ b/v2/scripts/build-korea-conversion-artifact.mts
@@ -0,0 +1,404 @@
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+import {
+  DEFAULT_CONVERSION_PAIR_OPTIONS,
+  KOREA_CONVERSION_ARTIFACT_VERSION,
+  KR_MOLIT_RENT_RIGHTS,
+  buildKoreaConversionCurves,
+  parseKoreaConversionArtifact,
+  type ConversionCurveBuild,
+  type ConversionPairOptions,
+  type KoreaConversionInputRecord,
+  type MolitRightsLookup,
+} from '@signedprice/korea-rent';
+
+/**
+ * Builds the Korea conversion-curve artifact the Contract Check screen runs on.
+ *
+ * The screen is not unbuilt - it is starved. `buildContractCheckRouteModel`
+ * reads three environment variables, and if the artifact is absent or fails its
+ * schema the whole screen degrades to "Comparison paused." This script produces
+ * the artifact and prints the three values to set.
+ *
+ * The one rule that governs everything here: NEVER WRITE AN ARTIFACT THE SITE
+ * WOULD REJECT, AND NEVER WRITE A NUMBER NOBODY MEASURED. The output is parsed
+ * with the site's own `parseKoreaConversionArtifact` before it is written, so a
+ * file that lands on disk is a file the deployment will accept. Bands too thin
+ * to measure are dropped upstream rather than filled in.
+ *
+ *   MOLIT contracts in -> pairs -> band medians + real pair counts -> artifact
+ *
+ * Usage:
+ *   node --experimental-strip-types v2/scripts/build-korea-conversion-artifact.mts \
+ *     --input data/molit/apartment-rent.json \
+ *     --output v2/apps/web/data/korea-conversion-curve.json \
+ *     --period 2026-01/2026-07
+ *
+ * The input is either a `KoreaConversionInputRecord[]` (or `{ records: [...] }`), or raw
+ * MOLIT 전월세 rows, which are normalised below. Contracts WITH monthly rent are
+ * required: a conversion rate only exists between a deposit-heavy filing and a
+ * rent-bearing one, so a zero-rent-only extract cannot produce this artifact.
+ */
+
+export type KoreaConversionRunnerOptions = Readonly<{
+  inputPath: string;
+  outputPath: string;
+  /** `YYYY-MM/YYYY-MM`, and it must match the deployed period exactly. */
+  period: string;
+  maximumAgeDays?: number;
+  pairOptions?: ConversionPairOptions;
+  now?: () => Date;
+  log?: (line: string) => void;
+}>;
+
+export type KoreaConversionRunnerResult = Readonly<{
+  artifact: string;
+  sha256: string;
+  period: string;
+  build: ConversionCurveBuild;
+}>;
+
+const rightsLookup: MolitRightsLookup = (policyId) =>
+  policyId === KR_MOLIT_RENT_RIGHTS.id ? KR_MOLIT_RENT_RIGHTS : undefined;
+
+/** Both curves are required: the route model asks for each by name and fails if either is absent. */
+const REQUIRED_HOUSING_TYPES = ['apartment', 'officetel'] as const;
+
+const PERIOD_PATTERN = /^\d{4}-(?:0[1-9]|1[0-2])\/\d{4}-(?:0[1-9]|1[0-2])$/;
+
+export class ConversionBuildError extends Error {
+  readonly code: string;
+
+  constructor(code: string, message: string) {
+    super(message);
+    this.name = 'ConversionBuildError';
+    this.code = code;
+  }
+}
+
+// ---------------------------------------------------------------- normalise
+
+function text(value: unknown): string {
+  return typeof value === 'string' ? value.trim() : typeof value === 'number' ? String(value) : '';
+}
+
+/**
+ * MOLIT money arrives in 만원 as a comma-grouped string ("25,000"). Multiplying
+ * by 10,000 late - after parsing, never during string handling - is what keeps
+ * the ten-times error out of this file.
+ */
+function manwonToWon(value: unknown): number | null {
+  const raw = text(value).replace(/,/g, '');
+  if (raw === '') return 0;
+  const manwon = Number(raw);
+  if (!Number.isFinite(manwon) || manwon < 0) return null;
+  return Math.round(manwon * 10_000);
+}
+
+function looksLikeMolitRow(value: Record<string, unknown>): boolean {
+  return 'deposit' in value && ('dealYear' in value || 'dealDay' in value);
+}
+
+/**
+ * Raw MOLIT 전월세 row -> `KoreaConversionInputRecord`. The building-name field differs per
+ * endpoint (`aptNm`, `offiNm`, `mhouseNm`), so the housing type is inferred from
+ * whichever is present unless the caller already tagged the row.
+ */
+function normaliseMolitRow(row: Record<string, unknown>): KoreaConversionInputRecord | null {
+  const apartmentName = text(row.aptNm);
+  const officetelName = text(row.offiNm);
+  const buildingLabel = apartmentName || officetelName || text(row.mhouseNm);
+  if (buildingLabel === '') return null;
+
+  const sourceHousingType = officetelName !== '' ? 'officetel' : 'apartment';
+
+  const year = Number(text(row.dealYear));
+  const month = Number(text(row.dealMonth));
+  const day = Number(text(row.dealDay));
+  if (!Number.isFinite(year) || !Number.isFinite(month) || !Number.isFinite(day)) return null;
+  const contractDate =
+    `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
+
+  const depositWon = manwonToWon(row.deposit);
+  const monthlyRentWon = manwonToWon(row.monthlyRent);
+  if (depositWon === null || monthlyRentWon === null) return null;
+
+  const areaSqm = Number(text(row.excluUseAr));
+  if (!Number.isFinite(areaSqm) || areaSqm <= 0) return null;
+
+  const filedType = text(row.contractType);
+  const contractType = filedType === '신규' ? 'new' : filedType === '갱신' ? 'renewal' : 'unknown';
+
+  // The rent endpoints carry no cancellation flag today. If one appears it is
+  // honoured; absence is recorded as unknown rather than asserted as active.
+  const cancelled = text(row.cancelDealType) !== '' || text(row.해제여부) !== '';
+
+  return {
+    contractType,
+    contractDate,
+    areaSqm,
+    depositWon,
+    monthlyRentWon,
+    buildingLabel,
+    legalDong: text(row.umdNm),
+    sourceHousingType,
+    recordStatus: cancelled ? 'cancelled' : 'unknown',
+    // MOLIT is queried one LAWD_CD at a time, so the district is always known
+    // at the wire. Dropping it here is what would let 신사동 in 강남구 pair with
+    // 신사동 in 관악구.
+    districtCode: text(row.sggCd),
+  } as KoreaConversionInputRecord;
+}
+
+/**
+ * Accepts a plain array, `{ records: [...] }`, or the collector's
+ * `{ cells: { "gu:ym": [rows] }, holes: [...] }` checkpoint.
+ *
+ * A checkpoint carrying holes is REFUSED. A hole is a district-month the
+ * collector could not read, and a curve built over one is a curve with a gap
+ * it cannot see - exactly the failure that once produced a half-empty panel.
+ */
+export function extractRecords(source: unknown): readonly KoreaConversionInputRecord[] {
+  let rows: unknown[];
+
+  if (Array.isArray(source)) {
+    rows = source;
+  } else if (source !== null && typeof source === 'object') {
+    const record = source as Record<string, unknown>;
+    if (Array.isArray(record.holes) && record.holes.length > 0) {
+      throw new ConversionBuildError(
+        'input_has_holes',
+        `Input has ${record.holes.length} uncollected district-months. Re-run the collector to fill them; do not model on a panel with holes.`,
+      );
+    }
+    if (Array.isArray(record.records)) {
+      rows = record.records;
+    } else if (record.cells !== null && typeof record.cells === 'object') {
+      rows = Object.values(record.cells as Record<string, unknown>).flatMap((cell) =>
+        Array.isArray(cell) ? cell : [],
+      );
+    } else {
+      throw new ConversionBuildError('input_unrecognised', 'Input is an object with no records, cells or array payload.');
+    }
+  } else {
+    throw new ConversionBuildError('input_unrecognised', 'Input is neither an array nor an object.');
+  }
+
+  const out: KoreaConversionInputRecord[] = [];
+  let unusableRows = 0;
+  for (const row of rows) {
+    if (row === null || typeof row !== 'object') {
+      unusableRows += 1;
+      continue;
+    }
+    const value = row as Record<string, unknown>;
+    if (looksLikeMolitRow(value)) {
+      const normalised = normaliseMolitRow(value);
+      if (normalised === null) unusableRows += 1;
+      else out.push(normalised);
+      continue;
+    }
+    if (typeof value.depositWon === 'number' && typeof value.monthlyRentWon === 'number') {
+      out.push(value as unknown as KoreaConversionInputRecord);
+      continue;
+    }
+    unusableRows += 1;
+  }
+
+  if (out.length === 0) {
+    throw new ConversionBuildError(
+      'input_empty',
+      `No usable contracts in the input (${unusableRows} rows unreadable). An empty result is a failure, not an answer.`,
+    );
+  }
+  return out;
+}
+
+// -------------------------------------------------------------------- build
+
+export function buildConversionArtifact(input: Readonly<{
+  records: readonly KoreaConversionInputRecord[];
+  period: string;
+  sha256: string;
+  generatedAt: string;
+  maximumAgeDays: number;
+  pairOptions: ConversionPairOptions;
+}>): Readonly<{ artifact: string; build: ConversionCurveBuild }> {
+  if (!PERIOD_PATTERN.test(input.period)) {
+    throw new ConversionBuildError('period_invalid', `Period must be YYYY-MM/YYYY-MM, received "${input.period}".`);
+  }
+
+  const build = buildKoreaConversionCurves(input.records, input.pairOptions);
+
+  const present = new Set(build.curves.map((curve) => curve.housingType));
+  const missing = REQUIRED_HOUSING_TYPES.filter((type) => !present.has(type));
+  if (missing.length > 0) {
+    // Writing a one-curve artifact would deploy cleanly and still leave the
+    // screen paused, with nothing on the page to say why.
+    throw new ConversionBuildError(
+      'curve_missing',
+      `No publishable curve for: ${missing.join(', ')}. Contract Check needs both, and each needs at least two bands holding ${input.pairOptions.minimumPairsPerAnchor}+ pairs. Widen the collection period or lower the minimum deliberately - do not invent anchors.`,
+    );
+  }
+
+  const artifact = {
+    artifactVersion: KOREA_CONVERSION_ARTIFACT_VERSION,
+    generatedAt: input.generatedAt,
+    provenance: {
+      marketId: 'kr-seoul',
+      period: input.period,
+      provider: 'MOLIT',
+      endpointVersion: 'v1',
+      parserVersion: 'kr-molit-rent-parser-v2',
+      rightsPolicyId: 'kr-molit-rent-v1',
+      sourceComplete: true,
+      sha256: input.sha256,
+    },
+    readiness: {
+      state: 'ready',
+      maximumAgeDays: input.maximumAgeDays,
+      minimumPairsPerAnchor: input.pairOptions.minimumPairsPerAnchor,
+    },
+    totals: {
+      eligiblePairCount: build.eligiblePairCount,
+      excluded: build.excluded,
+    },
+    curves: build.curves,
+  };
+
+  const serialised = JSON.stringify(artifact);
+
+  // The gate. Anything the site would refuse fails here, with the input still
+  // on disk and the previous artifact untouched.
+  parseKoreaConversionArtifact(
+    JSON.parse(serialised),
+    { marketId: 'kr-seoul', period: input.period, sha256: input.sha256, rightsLookup },
+    input.generatedAt,
+  );
+
+  return Object.freeze({ artifact: serialised, build });
+}
+
+// ------------------------------------------------------------------- runner
+
+export async function runKoreaConversionArtifactBuild(
+  options: KoreaConversionRunnerOptions,
+): Promise<KoreaConversionRunnerResult> {
+  const log = options.log ?? (() => {});
+  const now = options.now ?? (() => new Date());
+  const pairOptions = options.pairOptions ?? DEFAULT_CONVERSION_PAIR_OPTIONS;
+  const maximumAgeDays = options.maximumAgeDays ?? 45;
+
+  const inputPath = resolve(options.inputPath);
+  const bytes = await readFile(inputPath);
+
+  // The digest is over the SOURCE bytes, not the artifact. It answers the only
+  // question worth sealing: which extract produced these anchors.
+  const sha256 = createHash('sha256').update(bytes).digest('hex');
+
+  const records = extractRecords(JSON.parse(bytes.toString('utf8')));
+  const generatedAt = now().toISOString();
+
+  const { artifact, build } = buildConversionArtifact({
+    records,
+    period: options.period,
+    sha256,
+    generatedAt,
+    maximumAgeDays,
+    pairOptions,
+  });
+
+  const outputPath = resolve(options.outputPath);
+  await mkdir(dirname(outputPath), { recursive: true });
+  await writeFile(outputPath, `${artifact}\n`, 'utf8');
+
+  const { diagnostics } = build;
+  log(`records in            ${diagnostics.recordsIn.toLocaleString()}`);
+  log(`records usable        ${diagnostics.recordsUsable.toLocaleString()}`);
+  log(`building x area groups ${diagnostics.groupsConsidered.toLocaleString()}`);
+  log(`pairs formed          ${diagnostics.pairsFormed.toLocaleString()}`);
+  log(`pairs published       ${build.eligiblePairCount.toLocaleString()}`);
+  log('');
+  log('rejected pairs');
+  log(`  rent did not fall   ${diagnostics.rejections.rentDidNotFall.toLocaleString()}`);
+  log(`  deposit gap small   ${diagnostics.rejections.depositGapTooSmall.toLocaleString()}`);
+  log(`  outside date window ${diagnostics.rejections.outsideDateWindow.toLocaleString()}`);
+  log(`  implausible rate    ${diagnostics.rejections.implausibleRate.toLocaleString()}`);
+  log('');
+  for (const curve of build.curves) {
+    log(`${curve.housingType}`);
+    for (const anchor of curve.anchors) {
+      const eok = (anchor.depositWon / 100_000_000).toFixed(2);
+      const percent = (anchor.annualRate * 100).toFixed(2);
+      log(`  ${eok.padStart(6)}억  ${percent.padStart(5)}%/yr   ${anchor.pairCount.toLocaleString()} pairs`);
+    }
+  }
+  if (diagnostics.droppedAnchors.length > 0) {
+    log('');
+    log('dropped bands (measured, but under the publication floor)');
+    for (const dropped of diagnostics.droppedAnchors) {
+      const ceiling = dropped.bandCeilingWon === null
+        ? 'and up'
+        : `to ${(dropped.bandCeilingWon / 100_000_000).toFixed(2)}억`;
+      log(`  ${dropped.housingType} ${(dropped.bandFloorWon / 100_000_000).toFixed(2)}억 ${ceiling} — ${dropped.pairCount} pairs (${dropped.reason})`);
+    }
+  }
+  log('');
+  log(`wrote ${outputPath}`);
+  log('');
+  log('Set these three on the signedprice project (Production AND Preview):');
+  log(`  SIGNEDPRICE_CONVERSION_CURVE_PERIOD=${options.period}`);
+  log(`  SIGNEDPRICE_CONVERSION_CURVE_SHA256=${sha256}`);
+  log('  SIGNEDPRICE_CONVERSION_CURVE_ARTIFACT=<the file contents, one line>');
+  log('');
+  log(`This artifact expires ${maximumAgeDays} days after ${generatedAt}. After that the screen pauses again by design — rebuild and reset the variables.`);
+
+  return Object.freeze({ artifact, sha256, period: options.period, build });
+}
+
+// ---------------------------------------------------------------------- cli
+
+function argValue(argv: readonly string[], name: string): string | undefined {
+  const index = argv.indexOf(name);
+  return index >= 0 ? argv[index + 1] : undefined;
+}
+
+async function main(argv: readonly string[]): Promise<void> {
+  const inputPath = argValue(argv, '--input');
+  const outputPath = argValue(argv, '--output') ?? 'v2/apps/web/data/korea-conversion-curve.json';
+  const period = argValue(argv, '--period');
+  const minimumPairs = argValue(argv, '--minimum-pairs');
+  const maximumAgeDays = argValue(argv, '--maximum-age-days');
+
+  if (inputPath === undefined || period === undefined) {
+    throw new ConversionBuildError(
+      'usage',
+      'Usage: --input <contracts.json> --period <YYYY-MM/YYYY-MM> [--output <path>] [--minimum-pairs N] [--maximum-age-days N]',
+    );
+  }
+
+  const pairOptions: ConversionPairOptions = minimumPairs === undefined
+    ? DEFAULT_CONVERSION_PAIR_OPTIONS
+    : { ...DEFAULT_CONVERSION_PAIR_OPTIONS, minimumPairsPerAnchor: Number(minimumPairs) };
+
+  await runKoreaConversionArtifactBuild({
+    inputPath,
+    outputPath,
+    period,
+    maximumAgeDays: maximumAgeDays === undefined ? undefined : Number(maximumAgeDays),
+    pairOptions,
+    log: (line) => console.log(line),
+  });
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
+  main(process.argv.slice(2)).catch((error: unknown) => {
+    const message = error instanceof Error ? error.message : String(error);
+    console.error(`\nbuild failed: ${message}`);
+    console.error('Nothing was written. The deployed artifact is untouched.');
+    process.exit(1);
+  });
+}
diff --git a/v2/tests/korea-conversion-runner.test.ts b/v2/tests/korea-conversion-runner.test.ts
new file mode 100644
index 0000000..a8786fe
--- /dev/null
+++ b/v2/tests/korea-conversion-runner.test.ts
@@ -0,0 +1,207 @@
+import { mkdtemp, readFile, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import { describe, expect, it } from 'vitest';
+
+import {
+  DEFAULT_CONVERSION_PAIR_OPTIONS,
+  KR_MOLIT_RENT_RIGHTS,
+  parseKoreaConversionArtifact,
+  type MolitRightsLookup,
+} from '@signedprice/korea-rent';
+
+import {
+  ConversionBuildError,
+  extractRecords,
+  runKoreaConversionArtifactBuild,
+} from '../scripts/build-korea-conversion-artifact.mts';
+
+const PERIOD = '2026-01/2026-07';
+const rightsLookup: MolitRightsLookup = (policyId) =>
+  policyId === KR_MOLIT_RENT_RIGHTS.id ? KR_MOLIT_RENT_RIGHTS : undefined;
+
+const pairOptions = { ...DEFAULT_CONVERSION_PAIR_OPTIONS, minimumPairsPerAnchor: 2 };
+
+/**
+ * Rows in MOLIT's own wire shape: money in 만원 as comma-grouped strings, date
+ * split across three fields. A 24,000 만원 gap against a 100 만원 monthly
+ * difference implies 0.05 a year.
+ */
+function molitPairs(input: Readonly<{
+  count: number;
+  depositManwon: number;
+  annualRate: number;
+  building: string;
+  officetel?: boolean;
+}>): unknown[] {
+  const gapManwon = 24_000;
+  const monthlyRentManwon = (input.annualRate * gapManwon) / 12;
+  const rows: unknown[] = [];
+  for (let i = 0; i < input.count; i += 1) {
+    const name = `${input.building}-${i}`;
+    const nameField = input.officetel === true ? { offiNm: name } : { aptNm: name };
+    rows.push({
+      ...nameField,
+      sggCd: '11440',
+      umdNm: '성산동',
+      excluUseAr: '84.97',
+      dealYear: '2026',
+      dealMonth: '3',
+      dealDay: '10',
+      deposit: input.depositManwon.toLocaleString('en-US'),
+      monthlyRent: String(monthlyRentManwon),
+      contractType: '신규',
+    });
+    rows.push({
+      ...nameField,
+      sggCd: '11440',
+      umdNm: '성산동',
+      excluUseAr: '84.97',
+      dealYear: '2026',
+      dealMonth: '4',
+      dealDay: '2',
+      deposit: (input.depositManwon + gapManwon).toLocaleString('en-US'),
+      monthlyRent: '0',
+      contractType: '신규',
+    });
+  }
+  return rows;
+}
+
+function completeInput(): unknown[] {
+  return [
+    ...molitPairs({ count: 3, depositManwon: 6_000, annualRate: 0.05, building: 'A' }),
+    ...molitPairs({ count: 3, depositManwon: 20_000, annualRate: 0.045, building: 'B' }),
+    ...molitPairs({ count: 3, depositManwon: 5_000, annualRate: 0.06, building: 'C', officetel: true }),
+    ...molitPairs({ count: 3, depositManwon: 13_000, annualRate: 0.05, building: 'D', officetel: true }),
+  ];
+}
+
+async function workspace(rows: unknown): Promise<Readonly<{ inputPath: string; outputPath: string }>> {
+  const dir = await mkdtemp(join(tmpdir(), 'conversion-'));
+  const inputPath = join(dir, 'contracts.json');
+  await writeFile(inputPath, JSON.stringify(rows), 'utf8');
+  return { inputPath, outputPath: join(dir, 'curve.json') };
+}
+
+describe('runKoreaConversionArtifactBuild', () => {
+  it('writes an artifact the deployed parser accepts unchanged', async () => {
+    const { inputPath, outputPath } = await workspace(completeInput());
+
+    const result = await runKoreaConversionArtifactBuild({
+      inputPath,
+      outputPath,
+      period: PERIOD,
+      pairOptions,
+      now: () => new Date('2026-09-01T00:00:00.000Z'),
+    });
+
+    const written = JSON.parse(await readFile(outputPath, 'utf8'));
+
+    // The site's own parser, not a copy of its rules.
+    const parsed = parseKoreaConversionArtifact(
+      written,
+      { marketId: 'kr-seoul', period: PERIOD, sha256: result.sha256, rightsLookup },
+      '2026-09-02T00:00:00.000Z',
+    );
+
+    expect(parsed.curves.map((curve) => curve.housingType).sort()).toEqual([
+      'apartment',
+      'officetel',
+    ]);
+    expect(parsed.sha256).toMatch(/^[a-f0-9]{64}$/);
+  });
+
+  it('converts 만원 to 원 without the ten-times error', async () => {
+    const { inputPath, outputPath } = await workspace(completeInput());
+
+    const result = await runKoreaConversionArtifactBuild({
+      inputPath,
+      outputPath,
+      period: PERIOD,
+      pairOptions,
+      now: () => new Date('2026-09-01T00:00:00.000Z'),
+    });
+
+    const apartment = result.build.curves.find((curve) => curve.housingType === 'apartment')!;
+    // 6,000 만원 is 60,000,000 원. 600,000,000 would be the classic slip.
+    expect(apartment.anchors[0]!.depositWon).toBe(60_000_000);
+    expect(apartment.anchors[0]!.annualRate).toBe(0.05);
+    expect(apartment.anchors[1]!.depositWon).toBe(200_000_000);
+    expect(apartment.anchors[1]!.annualRate).toBe(0.045);
+  });
+
+  it('reports eligiblePairCount as the exact sum the parser recomputes', async () => {
+    const { inputPath, outputPath } = await workspace(completeInput());
+
+    const result = await runKoreaConversionArtifactBuild({
+      inputPath,
+      outputPath,
+      period: PERIOD,
+      pairOptions,
+      now: () => new Date('2026-09-01T00:00:00.000Z'),
+    });
+
+    const artifact = JSON.parse(result.artifact);
+    const summed = artifact.curves.reduce(
+      (sum: number, curve: { anchors: readonly { pairCount: number }[] }) =>
+        sum + curve.anchors.reduce((inner, anchor) => inner + anchor.pairCount, 0),
+      0,
+    );
+    expect(artifact.totals.eligiblePairCount).toBe(summed);
+  });
+
+  it('refuses to write when a required curve cannot be measured', async () => {
+    // Apartments only: Contract Check asks for both curves by name.
+    const { inputPath, outputPath } = await workspace([
+      ...molitPairs({ count: 3, depositManwon: 6_000, annualRate: 0.05, building: 'A' }),
+      ...molitPairs({ count: 3, depositManwon: 20_000, annualRate: 0.045, building: 'B' }),
+    ]);
+
+    await expect(
+      runKoreaConversionArtifactBuild({ inputPath, outputPath, period: PERIOD, pairOptions }),
+    ).rejects.toThrow(/officetel/);
+
+    await expect(readFile(outputPath, 'utf8')).rejects.toThrow();
+  });
+
+  it('refuses an input panel that still has collection holes', () => {
+    expect(() =>
+      extractRecords({ cells: {}, holes: [{ gu: '11440', ym: '202603', reason: 'HTTP 500' }] }),
+    ).toThrow(ConversionBuildError);
+  });
+
+  it('treats an empty extract as a failure, not an answer', () => {
+    expect(() => extractRecords({ records: [] })).toThrow(/failure, not an answer/);
+  });
+
+  it('rejects a malformed period before doing any work', async () => {
+    const { inputPath, outputPath } = await workspace(completeInput());
+
+    await expect(
+      runKoreaConversionArtifactBuild({
+        inputPath,
+        outputPath,
+        period: '2026-01..2026-07',
+        pairOptions,
+      }),
+    ).rejects.toThrow(/YYYY-MM/);
+  });
+
+  it('produces a digest that changes when the source extract changes', async () => {
+    const first = await workspace(completeInput());
+    const second = await workspace([...completeInput(), ...molitPairs({
+      count: 2,
+      depositManwon: 9_000,
+      annualRate: 0.048,
+      building: 'E',
+    })]);
+
+    const now = () => new Date('2026-09-01T00:00:00.000Z');
+    const a = await runKoreaConversionArtifactBuild({ ...first, period: PERIOD, pairOptions, now });
+    const b = await runKoreaConversionArtifactBuild({ ...second, period: PERIOD, pairOptions, now });
+
+    expect(a.sha256).not.toBe(b.sha256);
+  });
+});
