diff --git a/v2/packages/korea-rent/test/conversion-pairs.test.ts b/v2/packages/korea-rent/test/conversion-pairs.test.ts
new file mode 100644
index 0000000..43735cc
--- /dev/null
+++ b/v2/packages/korea-rent/test/conversion-pairs.test.ts
@@ -0,0 +1,215 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  DEFAULT_CONVERSION_PAIR_OPTIONS,
+  buildKoreaConversionCurves,
+  type ConversionPairOptions,
+} from '../src/conversion-pairs';
+import type { KoreaConversionInputRecord } from '../src/conversion-pairs';
+
+/**
+ * Every case here plants a rate the arithmetic must recover exactly. A pair
+ * with a 240,000,000 won deposit gap and a 1,000,000 won monthly difference
+ * implies 12,000,000 / 240,000,000 = 0.05 a year, so the assertions below are
+ * checking the measurement, not a tolerance.
+ */
+
+const options: ConversionPairOptions = {
+  ...DEFAULT_CONVERSION_PAIR_OPTIONS,
+  // Real runs demand 120 pairs an anchor; the fixtures here are deliberately
+  // small, so the floor moves and nothing else does.
+  minimumPairsPerAnchor: 2,
+};
+
+function record(input: Partial<KoreaConversionInputRecord> & Pick<KoreaConversionInputRecord, 'depositWon' | 'monthlyRentWon'>): KoreaConversionInputRecord {
+  return {
+    contractType: 'new',
+    contractDate: '2026-03-10',
+    districtCode: '11440',
+    areaSqm: 84.97,
+    buildingLabel: '성산시영',
+    legalDong: '성산동',
+    sourceHousingType: 'apartment',
+    recordStatus: 'active',
+    ...input,
+  } as KoreaConversionInputRecord;
+}
+
+/** `count` pairs keyed at `depositWon`, each implying exactly `annualRate`. */
+function pairsAt(input: Readonly<{
+  count: number;
+  depositWon: number;
+  annualRate: number;
+  building?: string;
+  housingType?: 'apartment' | 'officetel';
+}>): KoreaConversionInputRecord[] {
+  const gap = 240_000_000;
+  const monthlyRentWon = (input.annualRate * gap) / 12;
+  const out: KoreaConversionInputRecord[] = [];
+  for (let i = 0; i < input.count; i += 1) {
+    // A distinct building per pair keeps every group at exactly two records,
+    // so `count` pairs means `count` pairs and not a combinatorial explosion.
+    const buildingLabel = `${input.building ?? 'B'}-${i}`;
+    const common = { buildingLabel, sourceHousingType: input.housingType ?? 'apartment' } as const;
+    out.push(record({ ...common, depositWon: input.depositWon, monthlyRentWon }));
+    out.push(record({ ...common, depositWon: input.depositWon + gap, monthlyRentWon: 0 }));
+  }
+  return out;
+}
+
+describe('buildKoreaConversionCurves', () => {
+  it('recovers the planted rate and keys it at the lower deposit', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        ...pairsAt({ count: 3, depositWon: 60_000_000, annualRate: 0.05 }),
+        ...pairsAt({ count: 3, depositWon: 200_000_000, annualRate: 0.045, building: 'H' }),
+      ],
+      options,
+    );
+
+    const apartment = build.curves.find((curve) => curve.housingType === 'apartment');
+    expect(apartment).toBeDefined();
+    expect(apartment!.anchors).toEqual([
+      { depositWon: 60_000_000, annualRate: 0.05, pairCount: 3 },
+      { depositWon: 200_000_000, annualRate: 0.045, pairCount: 3 },
+    ]);
+    expect(apartment!.observedMinDepositWon).toBe(60_000_000);
+    expect(apartment!.observedMaxDepositWon).toBe(200_000_000);
+  });
+
+  it('reports eligiblePairCount as exactly the sum of published anchors', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        ...pairsAt({ count: 4, depositWon: 60_000_000, annualRate: 0.05 }),
+        ...pairsAt({ count: 5, depositWon: 200_000_000, annualRate: 0.045, building: 'H' }),
+        // One lone band under the floor: its pairs must NOT reach the total.
+        ...pairsAt({ count: 1, depositWon: 460_000_000, annualRate: 0.04, building: 'T' }),
+      ],
+      options,
+    );
+
+    const published = build.curves.flatMap((curve) => curve.anchors);
+    const summed = published.reduce((sum, anchor) => sum + anchor.pairCount, 0);
+    expect(build.eligiblePairCount).toBe(summed);
+    expect(build.eligiblePairCount).toBe(9);
+  });
+
+  it('drops a band below the minimum instead of publishing a thin anchor', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        ...pairsAt({ count: 3, depositWon: 60_000_000, annualRate: 0.05 }),
+        ...pairsAt({ count: 3, depositWon: 200_000_000, annualRate: 0.045, building: 'H' }),
+        ...pairsAt({ count: 1, depositWon: 460_000_000, annualRate: 0.04, building: 'T' }),
+      ],
+      options,
+    );
+
+    const apartment = build.curves.find((curve) => curve.housingType === 'apartment')!;
+    expect(apartment.anchors).toHaveLength(2);
+    expect(apartment.observedMaxDepositWon).toBe(200_000_000);
+    expect(build.diagnostics.droppedAnchors).toContainEqual({
+      housingType: 'apartment',
+      bandFloorWon: 450_000_000,
+      bandCeilingWon: null,
+      pairCount: 1,
+      reason: 'below_minimum_pairs',
+    });
+  });
+
+  it('omits a housing type that cannot reach two anchors', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        ...pairsAt({ count: 3, depositWon: 60_000_000, annualRate: 0.05 }),
+        ...pairsAt({ count: 3, depositWon: 200_000_000, annualRate: 0.045, building: 'H' }),
+        ...pairsAt({
+          count: 3,
+          depositWon: 50_000_000,
+          annualRate: 0.06,
+          building: 'O',
+          housingType: 'officetel',
+        }),
+      ],
+      options,
+    );
+
+    expect(build.curves.map((curve) => curve.housingType)).toEqual(['apartment']);
+    expect(build.diagnostics.omittedHousingTypes).toEqual(['officetel']);
+  });
+
+  it('rejects a pair whose rent did not fall as the deposit rose', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        record({ buildingLabel: 'X', depositWon: 60_000_000, monthlyRentWon: 500_000 }),
+        record({ buildingLabel: 'X', depositWon: 300_000_000, monthlyRentWon: 900_000 }),
+      ],
+      options,
+    );
+
+    expect(build.diagnostics.pairsFormed).toBe(0);
+    expect(build.diagnostics.rejections.rentDidNotFall).toBe(1);
+    expect(build.curves).toEqual([]);
+  });
+
+  it('rejects a pair signed outside the date window', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        record({
+          buildingLabel: 'X',
+          contractDate: '2026-01-05',
+          depositWon: 60_000_000,
+          monthlyRentWon: 1_000_000,
+        }),
+        record({
+          buildingLabel: 'X',
+          contractDate: '2026-07-20',
+          depositWon: 300_000_000,
+          monthlyRentWon: 0,
+        }),
+      ],
+      options,
+    );
+
+    expect(build.diagnostics.rejections.outsideDateWindow).toBe(1);
+    expect(build.diagnostics.pairsFormed).toBe(0);
+  });
+
+  it('counts cancelled filings and unusable money separately from unpaired records', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        record({ depositWon: 60_000_000, monthlyRentWon: 1_000_000, recordStatus: 'cancelled' }),
+        record({ depositWon: 0, monthlyRentWon: 900_000 }),
+        record({ buildingLabel: 'LONELY', depositWon: 200_000_000, monthlyRentWon: 500_000 }),
+      ],
+      options,
+    );
+
+    expect(build.excluded.cancelled).toBe(1);
+    expect(build.excluded.invalidMoney).toBe(1);
+    expect(build.excluded.differentBuildingOrArea).toBe(1);
+  });
+
+  it('does not pair across different filed areas in the same building', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        record({ areaSqm: 84.97, depositWon: 60_000_000, monthlyRentWon: 1_000_000 }),
+        record({ areaSqm: 59.94, depositWon: 300_000_000, monthlyRentWon: 0 }),
+      ],
+      options,
+    );
+
+    expect(build.diagnostics.pairsFormed).toBe(0);
+    expect(build.excluded.differentBuildingOrArea).toBe(2);
+  });
+
+  it('does not pair across legal dongs that share a building name', () => {
+    const build = buildKoreaConversionCurves(
+      [
+        record({ legalDong: '성산동', depositWon: 60_000_000, monthlyRentWon: 1_000_000 }),
+        record({ legalDong: '망원동', depositWon: 300_000_000, monthlyRentWon: 0 }),
+      ],
+      options,
+    );
+
+    expect(build.diagnostics.pairsFormed).toBe(0);
+  });
+});
