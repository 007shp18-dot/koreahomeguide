+import { normalizeKoreaBuildingText } from './building-identity';
+import type { KoreaRentRecord } from './input';
+import type {
+  KoreaConversionHousingType,
+  VerifiedKoreaConversionAnchor,
+  VerifiedKoreaConversionCurve,
+} from './conversion-artifact';
+
+/**
+ * A filed record plus the district it was queried under. MOLIT answers per
+ * `LAWD_CD`, so the caller always knows this even though `KoreaRentRecord`
+ * does not carry it - and without it two different buildings can collide
+ * (신사동 exists in both 강남구 and 관악구).
+ */
+export type KoreaConversionInputRecord = KoreaRentRecord & Readonly<{
+  districtCode?: string;
+}>;
+
+/**
+ * Deriving the measured conversion curve from filed contracts.
+ *
+ * Everything else this site publishes is a distribution of deposits. This is
+ * the one number that is not observable in any single contract: what a
+ * landlord charged, per won of deposit not paid, to accept monthly rent
+ * instead. It only appears BETWEEN two contracts.
+ *
+ * The pair is the unit of evidence:
+ *
+ *   same building x same filed area x two different deposits
+ *   =>  rate = (rentLow - rentHigh) * 12 / (depositHigh - depositLow)
+ *
+ * That is the statutory 전월세전환율 written generally. With the higher-deposit
+ * side at zero rent it reduces to the familiar
+ * `monthlyRent * 12 / (jeonseDeposit - wolseDeposit)`.
+ *
+ * THE RATE IS KEYED AT THE LOWER DEPOSIT. That is the deposit actually written
+ * on the contract carrying the rent, and the published rule is that a rate is
+ * read at the deposit on the contract, never at a deposit nobody signed.
+ * Keying at the midpoint or the higher side would attribute a rate to a
+ * transaction that did not happen.
+ *
+ * Two properties of the result matter and both fall out of the data rather
+ * than being assumed here: the rate differs by housing type, and it falls as
+ * the deposit rises. Neither is imposed - if the contracts do not show it, the
+ * bands will not show it either.
+ *
+ * What this module refuses to do is as important as what it computes. A band
+ * holding fewer pairs than the configured minimum is DROPPED, not published
+ * with a wide error bar; a curve left with fewer than two surviving anchors is
+ * omitted entirely rather than extrapolated. An anchor that cannot be measured
+ * is absent, never estimated.
+ */
+
+export type ConversionPairExclusions = Readonly<{
+  /** Filed then cancelled. Never evidence of a price. */
+  cancelled: number;
+  /** Money or area unusable: non-finite, negative, or a zero-deposit record. */
+  invalidMoney: number;
+  /** Survived cleaning but found no partner in the same building and area. */
+  differentBuildingOrArea: number;
+}>;
+
+export type ConversionPairRejections = Readonly<{
+  /** Rent did not fall as deposit rose. Not a conversion; a different unit. */
+  rentDidNotFall: number;
+  /** Deposits too close together - the denominator is noise. */
+  depositGapTooSmall: number;
+  /** Signed too far apart to be the same market. */
+  outsideDateWindow: number;
+  /** Implied rate outside the plausible band. */
+  implausibleRate: number;
+}>;
+
+export type DroppedAnchor = Readonly<{
+  housingType: KoreaConversionHousingType;
+  bandFloorWon: number;
+  bandCeilingWon: number | null;
+  pairCount: number;
+  reason: 'below_minimum_pairs' | 'deposit_not_increasing';
+}>;
+
+export type ConversionCurveDiagnostics = Readonly<{
+  recordsIn: number;
+  recordsUsable: number;
+  groupsConsidered: number;
+  pairsFormed: number;
+  rejections: ConversionPairRejections;
+  droppedAnchors: readonly DroppedAnchor[];
+  omittedHousingTypes: readonly KoreaConversionHousingType[];
+}>;
+
+export type ConversionCurveBuild = Readonly<{
+  curves: readonly VerifiedKoreaConversionCurve[];
+  eligiblePairCount: number;
+  excluded: ConversionPairExclusions;
+  diagnostics: ConversionCurveDiagnostics;
+}>;
+
+export type ConversionPairOptions = Readonly<{
+  /** A band with fewer pairs than this is dropped. Mirrors the artifact field. */
+  minimumPairsPerAnchor: number;
+  /** Contracts further apart than this are different markets, not a pair. */
+  maximumDaysBetween: number;
+  /** Below this gap the implied rate is dominated by rounding. */
+  minimumDepositGapWon: number;
+  /** Inclusive plausible annual rate band, as fractions. */
+  minimumAnnualRate: number;
+  maximumAnnualRate: number;
+  /** Ascending band floors in won, per housing type. Last band is open-ended. */
+  bandFloorsWon: Readonly<Record<KoreaConversionHousingType, readonly number[]>>;
+  /** Guard against a pathological group blowing up the O(n^2) pairing. */
+  maximumGroupSize: number;
+}>;
+
+/**
+ * Band floors are deliberately coarse at the top: filed contracts thin out as
+ * the deposit rises, and a band nobody can fill is a band that gets dropped.
+ */
+export const DEFAULT_CONVERSION_PAIR_OPTIONS: ConversionPairOptions = Object.freeze({
+  minimumPairsPerAnchor: 120,
+  maximumDaysBetween: 90,
+  minimumDepositGapWon: 10_000_000,
+  minimumAnnualRate: 0.005,
+  maximumAnnualRate: 0.15,
+  maximumGroupSize: 400,
+  bandFloorsWon: Object.freeze({
+    apartment: Object.freeze([
+      0, 40_000_000, 75_000_000, 125_000_000, 175_000_000, 250_000_000, 350_000_000, 450_000_000,
+    ]),
+    officetel: Object.freeze([
+      0, 40_000_000, 62_500_000, 87_500_000, 125_000_000, 175_000_000,
+    ]),
+  }),
+});
+
+const HOUSING_TYPES: readonly KoreaConversionHousingType[] = Object.freeze([
+  'apartment',
+  'officetel',
+]);
+
+const DAY_MS = 86_400_000;
+
+type UsableRecord = Readonly<{
+  groupKey: string;
+  housingType: KoreaConversionHousingType;
+  depositWon: number;
+  monthlyRentWon: number;
+  signedAtMs: number;
+}>;
+
+type Pair = Readonly<{
+  housingType: KoreaConversionHousingType;
+  /** The deposit the rate is read at: the lower of the two. */
+  keyedDepositWon: number;
+  annualRate: number;
+}>;
+
+function isConversionHousingType(value: string): value is KoreaConversionHousingType {
+  return value === 'apartment' || value === 'officetel';
+}
+
+function finitePositive(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0;
+}
+
+function finiteNonNegative(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0;
+}
+
+/**
+ * Contract dates arrive as ISO-ish strings. A record whose date will not parse
+ * cannot be windowed, so it is unusable rather than silently dated to now.
+ */
+function signedAt(record: KoreaRentRecord): number | null {
+  const parsed = new Date(record.contractDate).getTime();
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+/**
+ * Identity has to be strict in both directions.
+ *
+ * Too loose and pairs are manufactured across buildings that merely share a
+ * name - dong names repeat across districts (신사동 exists in both 강남구 and
+ * 관악구), so the district code is part of the key rather than an optimisation.
+ * Too tight and real pairs are lost to cosmetics, so names go through the same
+ * `normalizeKoreaBuildingText` the building artifact uses (NFKC, collapsed
+ * whitespace) instead of a bare trim - otherwise a full-width character or a
+ * doubled space silently splits one complex in two and every pair inside it
+ * disappears.
+ *
+ * Area is matched at 0.01 sqm, the precision the filing itself carries. The
+ * separator is an escaped NUL because it cannot occur in any of the parts.
+ */
+function groupKeyOf(
+  record: KoreaConversionInputRecord,
+  housingType: KoreaConversionHousingType,
+): string | null {
+  if (record.buildingLabel === undefined || record.legalDong === undefined) return null;
+  const building = normalizeKoreaBuildingText(record.buildingLabel);
+  const dong = normalizeKoreaBuildingText(record.legalDong);
+  const district = record.districtCode?.trim();
+  if (building === '' || dong === '' || district === undefined || district === '') return null;
+  if (!finitePositive(record.areaSqm)) return null;
+  const area = record.areaSqm.toFixed(2);
+  return [housingType, district, dong, building, area].join('\u0000');
+}
+
+function median(sorted: readonly number[]): number {
+  const middle = sorted.length >> 1;
+  return sorted.length % 2 === 1
+    ? sorted[middle]!
+    : (sorted[middle - 1]! + sorted[middle]!) / 2;
+}
+
+/**
+ * The band a keyed deposit belongs to: the index of the highest floor it
+ * reaches. Floors ascend and the final band is open-ended.
+ */
+function bandIndexOf(depositWon: number, floors: readonly number[]): number {
+  let index = 0;
+  for (let i = 0; i < floors.length; i += 1) {
+    if (depositWon >= floors[i]!) index = i;
+    else break;
+  }
+  return index;
+}
+
+export function buildKoreaConversionCurves(
+  records: readonly KoreaConversionInputRecord[],
+  options: ConversionPairOptions = DEFAULT_CONVERSION_PAIR_OPTIONS,
+): ConversionCurveBuild {
+  let cancelled = 0;
+  let invalidMoney = 0;
+
+  // ---- clean ------------------------------------------------------------
+  const byGroup = new Map<string, UsableRecord[]>();
+  for (const record of records) {
+    if (record.recordStatus === 'cancelled') {
+      cancelled += 1;
+      continue;
+    }
+    const housingType = record.sourceHousingType;
+    // Villa and detached filings exist but the published curve is typed, and a
+    // type with no curve is better than a type carrying another type's rate.
+    if (!isConversionHousingType(housingType)) continue;
+
+    if (!finitePositive(record.depositWon) || !finiteNonNegative(record.monthlyRentWon)) {
+      invalidMoney += 1;
+      continue;
+    }
+    const key = groupKeyOf(record, housingType);
+    if (key === null) {
+      invalidMoney += 1;
+      continue;
+    }
+    const ms = signedAt(record);
+    if (ms === null) {
+      invalidMoney += 1;
+      continue;
+    }
+
+    const bucket = byGroup.get(key);
+    const usable: UsableRecord = {
+      groupKey: key,
+      housingType,
+      depositWon: record.depositWon,
+      monthlyRentWon: record.monthlyRentWon,
+      signedAtMs: ms,
+    };
+    if (bucket === undefined) byGroup.set(key, [usable]);
+    else bucket.push(usable);
+  }
+
+  const recordsUsable = [...byGroup.values()].reduce((n, group) => n + group.length, 0);
+
+  // ---- pair -------------------------------------------------------------
+  const pairs: Pair[] = [];
+  let rentDidNotFall = 0;
+  let depositGapTooSmall = 0;
+  let outsideDateWindow = 0;
+  let implausibleRate = 0;
+  let unpairedRecords = 0;
+
+  const windowMs = options.maximumDaysBetween * DAY_MS;
+
+  for (const group of byGroup.values()) {
+    // A group of one can never produce a pair. Counting its members here is
+    // what makes "no comparable filing in the same building and area" visible
+    // in the published totals instead of vanishing.
+    if (group.length < 2) {
+      unpairedRecords += group.length;
+      continue;
+    }
+    if (group.length > options.maximumGroupSize) {
+      // Deterministic truncation beats a quadratic blow-up on a bad key.
+      group.length = options.maximumGroupSize;
+    }
+
+    let groupProducedPair = false;
+    for (let i = 0; i < group.length; i += 1) {
+      for (let j = i + 1; j < group.length; j += 1) {
+        const a = group[i]!;
+        const b = group[j]!;
+        const [low, high] = a.depositWon <= b.depositWon ? [a, b] : [b, a];
+
+        const gap = high.depositWon - low.depositWon;
+        if (gap < options.minimumDepositGapWon) {
+          depositGapTooSmall += 1;
+          continue;
+        }
+        if (Math.abs(a.signedAtMs - b.signedAtMs) > windowMs) {
+          outsideDateWindow += 1;
+          continue;
+        }
+        // More deposit must buy less rent. If it did not, the two filings
+        // differ in something this pairing cannot see, and the quotient would
+        // not be a conversion rate.
+        if (low.monthlyRentWon <= high.monthlyRentWon) {
+          rentDidNotFall += 1;
+          continue;
+        }
+
+        const annualRate = ((low.monthlyRentWon - high.monthlyRentWon) * 12) / gap;
+        if (annualRate < options.minimumAnnualRate || annualRate > options.maximumAnnualRate) {
+          implausibleRate += 1;
+          continue;
+        }
+
+        groupProducedPair = true;
+        pairs.push({
+          housingType: low.housingType,
+          keyedDepositWon: low.depositWon,
+          annualRate,
+        });
+      }
+    }
+    if (!groupProducedPair) unpairedRecords += group.length;
+  }
+
+  // ---- band -------------------------------------------------------------
+  const curves: VerifiedKoreaConversionCurve[] = [];
+  const droppedAnchors: DroppedAnchor[] = [];
+  const omittedHousingTypes: KoreaConversionHousingType[] = [];
+  let eligiblePairCount = 0;
+
+  for (const housingType of HOUSING_TYPES) {
+    const floors = options.bandFloorsWon[housingType];
+    const buckets = floors.map(() => ({ deposits: [] as number[], rates: [] as number[] }));
+
+    for (const pair of pairs) {
+      if (pair.housingType !== housingType) continue;
+      const bucket = buckets[bandIndexOf(pair.keyedDepositWon, floors)]!;
+      bucket.deposits.push(pair.keyedDepositWon);
+      bucket.rates.push(pair.annualRate);
+    }
+
+    const anchors: VerifiedKoreaConversionAnchor[] = [];
+    for (let index = 0; index < buckets.length; index += 1) {
+      const bucket = buckets[index]!;
+      const pairCount = bucket.rates.length;
+      const bandFloorWon = floors[index]!;
+      const bandCeilingWon = index + 1 < floors.length ? floors[index + 1]! : null;
+
+      if (pairCount < options.minimumPairsPerAnchor) {
+        if (pairCount > 0) {
+          droppedAnchors.push({
+            housingType,
+            bandFloorWon,
+            bandCeilingWon,
+            pairCount,
+            reason: 'below_minimum_pairs',
+          });
+        }
+        continue;
+      }
+
+      // The anchor sits at the median deposit actually keyed in this band, not
+      // at the band edge - an edge is our construct, the median is observed.
+      bucket.deposits.sort((x, y) => x - y);
+      bucket.rates.sort((x, y) => x - y);
+      const depositWon = Math.round(median(bucket.deposits));
+      // Median, not mean: one unusual filing must not move an anchor.
+      const annualRate = Number(median(bucket.rates).toFixed(4));
+
+      const previous = anchors.at(-1);
+      if (previous !== undefined && depositWon <= previous.depositWon) {
+        // Two bands whose medians collide cannot both be anchors; the schema
+        // requires strictly increasing deposits, and merging them silently
+        // would hide that the banding is too fine for this data.
+        droppedAnchors.push({
+          housingType,
+          bandFloorWon,
+          bandCeilingWon,
+          pairCount,
+          reason: 'deposit_not_increasing',
+        });
+        continue;
+      }
+
+      anchors.push({ depositWon, annualRate, pairCount });
+    }
+
+    // One anchor is a point, not a curve: nothing can be interpolated and the
+    // published rule outside the observed range is to hold, which needs a range.
+    if (anchors.length < 2) {
+      omittedHousingTypes.push(housingType);
+      continue;
+    }
+
+    eligiblePairCount += anchors.reduce((sum, anchor) => sum + anchor.pairCount, 0);
+    curves.push({
+      housingType,
+      observedMinDepositWon: anchors[0]!.depositWon,
+      observedMaxDepositWon: anchors.at(-1)!.depositWon,
+      anchors: Object.freeze(anchors),
+    });
+  }
+
+  return Object.freeze({
+    curves: Object.freeze(curves),
+    eligiblePairCount,
+    excluded: Object.freeze({
+      cancelled,
+      invalidMoney,
+      differentBuildingOrArea: unpairedRecords,
+    }),
+    diagnostics: Object.freeze({
+      recordsIn: records.length,
+      recordsUsable,
+      groupsConsidered: byGroup.size,
+      pairsFormed: pairs.length,
+      rejections: Object.freeze({
+        rentDidNotFall,
+        depositGapTooSmall,
+        outsideDateWindow,
+        implausibleRate,
+      }),
+      droppedAnchors: Object.freeze(droppedAnchors),
+      omittedHousingTypes: Object.freeze(omittedHousingTypes),
+    }),
+  });
+}
